# Example environment variables for local development
# Copy this file to .env.local and fill in real SMTP credentials.

# SMTP server host (e.g. smtp.gmail.com)
SMTP_HOST=smtp.example.com

# SMTP server port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# Set to "true" if using SSL (465), otherwise "false"
SMTP_SECURE=false

# SMTP auth username and password
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Optional from address used in emails
EMAIL_FROM="HavenScan <no-reply@yourdomain.com>"

# Note: For Gmail you may need an app password and to enable less-secure app access
